DATABASE_URL="postgresql://postgres:password@localhost:5432/quickbasket"
# Optional deployment-only direct Neon URL. Use it for migrations, not the running API.
DIRECT_URL="postgresql://postgres:password@localhost:5432/quickbasket"
# Integration tests only; the database name must contain test, testing, or ci.
TEST_DATABASE_URL="postgresql://postgres:password@localhost:5432/quickbasket_test"
JWT_SECRET="replace_with_secure_secret_at_least_32_characters"
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
JWT_EXPIRES_IN=1d
JWT_REMEMBER_EXPIRES_IN=30d
AUTH_COOKIE_NAME=quickbasket_session
TRUST_PROXY_HOPS=0
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
ADMIN_LOGIN_RATE_LIMIT_MAX=5
# Used only by `npm run prisma:seed --workspace backend`. Do not commit real credentials.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-unique-password
